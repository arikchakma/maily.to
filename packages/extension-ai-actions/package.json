{
  "name": "@maily-to/extension-ai-actions",
  "version": "0.0.1",
  "private": true,
  "description": "AI actions extension shell.",
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist",
    "dev": "vp pack --watch --no-clean",
    "release": "bumpp"
  },
  "dependencies": {
    "@maily-to/shared": "workspace:*"
  },
  "devDependencies": {
    "@maily-to/tsconfig": "workspace:*",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:"
  }
}
