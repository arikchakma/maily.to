{
  "name": "maily",
  "private": true,
  "scripts": {
    "build": "vp run build -r",
    "check": "vp check",
    "clean": "vp run clean -r",
    "dev": "vp run build -r && pnpm -r --parallel dev",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions --fix-dangerously",
    "prepare": "vp config",
    "release:core": "pnpm --filter @maily-to/core release",
    "release:migration": "pnpm --filter @maily-to/migration release",
    "release:render": "pnpm --filter @maily-to/render release",
    "release:shared": "pnpm --filter @maily-to/shared release",
    "release:ui": "pnpm --filter @maily-to/ui release",
    "test": "vp run test -r"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@typescript/native-preview": "latest",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
