{
  "name": "@maily-to/render",
  "version": "2.0.0-beta.2",
  "private": false,
  "description": "A transformer that converts Maily content into HTML email templates.",
  "keywords": [
    "email",
    "maily.to",
    "react"
  ],
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/render"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist",
    "dev": "vp pack --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp",
    "test": "vp test run"
  },
  "dependencies": {
    "@maily-to/migration": "workspace:*",
    "@maily-to/shared": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "juice": "^11.1.1",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@maily-to/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tiptap/core": "catalog:",
    "react": "catalog:"
  }
}
