{
  "name": "maily",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "clean": "vp run -r clean",
    "dev": "vp run -r --parallel dev",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix --fix-suggestions --fix-dangerously",
    "prepare": "vp config",
    "release": "bumpp packages/shared/package.json packages/migration/package.json packages/render/package.json packages/core/package.json --commit 'release: v%s' --tag 'v%s' --all",
    "release:core": "pnpm --filter @maily-to/core release",
    "release:extension-ai-actions": "pnpm --filter @maily-to/extension-ai-actions release",
    "release:extension-inline-suggestion": "pnpm --filter @maily-to/extension-inline-suggestion release",
    "release:extension-variable": "pnpm --filter @maily-to/extension-variable release",
    "release:migration": "pnpm --filter @maily-to/migration release",
    "release:render": "pnpm --filter @maily-to/render release",
    "release:shared": "pnpm --filter @maily-to/shared release",
    "test": "vp run -r test",
    "test:e2e": "vp exec playwright test"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@typescript/native-preview": "latest",
    "bumpp": "catalog:",
    "playwright": "^1.62.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
