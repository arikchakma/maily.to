{
  "name": "@maily-to/shared",
  "version": "0.0.1",
  "private": false,
  "description": "Shared utilities for Maily",
  "keywords": [
    "email",
    "maily.to",
    "react"
  ],
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/shared"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "clean": "rm -rf dist",
    "dev": "vp pack --watch",
    "release": "bumpp",
    "test": "vp test run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@maily-to/tsconfig": "workspace:*",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
