{
  "name": "@maily-to/core",
  "version": "2.0.0-beta.7",
  "private": false,
  "description": "Powerful editor for creating beautiful, pre-designed, mobile-ready emails.",
  "keywords": [
    "email",
    "email-editor",
    "maily.to",
    "react",
    "tiptap"
  ],
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./blocks": {
      "import": "./dist/blocks/index.mjs",
      "require": "./dist/blocks/index.cjs"
    },
    "./extensions": {
      "import": "./dist/extensions/index.mjs",
      "require": "./dist/extensions/index.cjs"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:style && pnpm run build:lib",
    "build:lib": "vp pack",
    "build:style": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css",
    "clean": "rm -rf dist",
    "dev": "pnpm --filter @maily-to/core --parallel \"/^dev:.*/\"",
    "dev:lib": "vp pack --watch",
    "dev:style": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css --watch",
    "release": "bumpp"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@floating-ui/react": "^0.27.20",
    "@floating-ui/utils": "^0.2.12",
    "@maily-to/migration": "workspace:*",
    "@maily-to/shared": "workspace:*",
    "@maily-to/ui": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-blockquote": "^3.29.2",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-drag-handle": "^3.29.2",
    "@tiptap/extension-drag-handle-react": "^3.29.2",
    "@tiptap/extension-file-handler": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-node-range": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extension-unique-id": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.28.0",
    "stylecast": "^0.0.6",
    "tailwind-merge": "^3.6.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@maily-to/extension-ai-actions": "workspace:*",
    "@maily-to/extension-inline-suggestion": "workspace:*",
    "@maily-to/extension-variable": "workspace:*",
    "@maily-to/tsconfig": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "bumpp": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
